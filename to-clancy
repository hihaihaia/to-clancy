<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>To Clancy</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ffdde1 0%, #ee9ca7 50%, #ffdde1 100%);
      font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
      overflow: hidden;
      position: relative;
    }

    /* ---------- 主按钮 ---------- */
    .btn {
      padding: 18px 42px;
      font-size: 20px;
      font-weight: 600;
      color: #fff;
      background: linear-gradient(135deg, #ff6b9d, #ee5a6f);
      border: none;
      border-radius: 50px;
      box-shadow: 0 8px 28px rgba(238, 90, 111, 0.45);
      cursor: pointer;
      transition: all 0.3s ease;
      position: relative;
      z-index: 10;
      letter-spacing: 1px;
      animation: pulse 2s infinite;
    }
    .btn:active {
      transform: scale(0.95);
      box-shadow: 0 4px 16px rgba(238, 90, 111, 0.5);
    }
    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    /* ---------- 弹窗 ---------- */
    .popup {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, 0.55);
      z-index: 100;
      padding: 20px;
      animation: fadeIn 0.4s ease;
    }
    .popup.show {
      display: flex;
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .popup-box {
      background: #fff;
      border-radius: 24px;
      padding: 40px 28px 32px;
      max-width: 360px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
      animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      position: relative;
      max-height: 80vh;
      overflow-y: auto;
    }
    @keyframes popIn {
      0% { transform: scale(0.5); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    .popup-box .cake {
      font-size: 52px;
      display: block;
      margin-bottom: 12px;
      animation: bounce 1.2s infinite;
    }
    @keyframes bounce {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }
    .popup-box h2 {
      font-size: 24px;
      color: #ee5a6f;
      margin-bottom: 18px;
      font-weight: 700;
    }
    .popup-box p {
      font-size: 16px;
      line-height: 1.9;
      color: #555;
      margin-bottom: 10px;
      text-align: left;
    }
    .popup-box .close-btn {
      margin-top: 24px;
      padding: 12px 36px;
      font-size: 22px;
      color: #fff;
      background: linear-gradient(135deg, #ff6b9d, #ee5a6f);
      border: none;
      border-radius: 40px;
      cursor: pointer;
      font-weight: 600;
      box-shadow: 0 6px 20px rgba(238, 90, 111, 0.35);
      transition: transform 0.2s;
    }
    .popup-box .close-btn:active {
      transform: scale(0.96);
    }

    /* ---------- 第二个画面（全屏） ---------- */
    .final-screen {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #ffdde1 0%, #ee9ca7 50%, #ffdde1 100%);
      z-index: 300;
      padding: 30px;
      text-align: center;
      animation: fadeIn 0.6s ease;
    }
    .final-screen.show {
      display: flex;
    }
    .final-content {
      max-width: 400px;
    }
    .final-content .line1 {
      font-size: 22px;
      color: #ee5a6f;
      font-weight: 700;
      line-height: 1.8;
      margin-bottom: 30px;
      animation: popIn 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .final-content .line2 {
      font-size: 36px;
      color: #fff;
      font-weight: 800;
      letter-spacing: 2px;
      text-shadow: 0 4px 20px rgba(238, 90, 111, 0.5);
      animation: popIn 1s 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    }
    .final-content .heart {
      font-size: 48px;
      display: block;
      margin-top: 30px;
      animation: bounce 1.5s infinite;
    }

    /* ---------- 飘心 ---------- */
    .heart-float {
      position: fixed;
      font-size: 24px;
      pointer-events: none;
      animation: floatUp 4s ease-in forwards;
      z-index: 200;
      opacity: 0;
    }
    @keyframes floatUp {
      0% { opacity: 1; transform: translateY(0) scale(0.6); }
      100% { opacity: 0; transform: translateY(-200px) scale(1.3); }
    }
  </style>
</head>
<body>

  <!-- 主按钮 -->
  <button class="btn" id="openBtn">接收谢大海的爱吧！</button>

  <!-- 第一个弹窗：敏姐的祝福 -->
  <div class="popup" id="popup">
    <div class="popup-box">
      <span class="cake">🎂</span>
      <h2>敏姐～生日快乐～</h2>
      <p>祝你身体健康，每天开心！</p>
      <p>愿你在照顾世界的同时，也被世界温柔照顾；<br>在努力变好的同时，也知道自己已经足够好💖。</p>
      <button class="close-btn" id="nextBtn">→</button>
    </div>
  </div>

  <!-- 第二个画面：最终祝福 -->
  <div class="final-screen" id="finalScreen">
    <div class="final-content">
      <div class="line1">To my dear Clancy, at 36 — with love.</div>
      <div class="line2">Happy Birthday.</div>
      <span class="heart">💖</span>
    </div>
  </div>

  <!-- 音频 -->
  <audio id="birthdayAudio" src="https://cdn.pixabay.com/download/audio/2022/03/15/audio_c8c8a73467.mp3" preload="auto" loop></audio>

  <script>
    var openBtn = document.getElementById('openBtn');
    var popup = document.getElementById('popup');
    var nextBtn = document.getElementById('nextBtn');
    var finalScreen = document.getElementById('finalScreen');
    var audio = document.getElementById('birthdayAudio');
    var isPlaying = false;

    // 打开第一个弹窗
    openBtn.addEventListener('click', function() {
      popup.classList.add('show');
      if (!isPlaying) {
        audio.play().then(function() {
          isPlaying = true;
        }).catch(function(e) {
          console.log('播放被阻止', e);
          audio.play();
        });
      }
      for (var i = 0; i < 6; i++) {
        setTimeout(createHeart, i * 200);
      }
    });

    // 点击“→” → 关闭弹窗，显示第二个画面
    nextBtn.addEventListener('click', function() {
      popup.classList.remove('show');
      finalScreen.classList.add('show');
      for (var i = 0; i < 8; i++) {
        setTimeout(createHeart, i * 180);
      }
    });

    // 点击遮罩关闭弹窗
    popup.addEventListener('click', function(e) {
      if (e.target === popup) {
        popup.classList.remove('show');
      }
    });

    // 飘心效果
    function createHeart() {
      var heart = document.createElement('div');
      heart.className = 'heart-float';
      heart.textContent = ['💖', '💕', '🌸', '✨', '🎉', '💝'][Math.floor(Math.random() * 6)];
      heart.style.left = (20 + Math.random() * 60) + '%';
      heart.style.bottom = '20%';
      heart.style.animationDuration = (3 + Math.random() * 2) + 's';
      document.body.appendChild(heart);
      setTimeout(function() {
        heart.remove();
      }, 5000);
    }
  </script>

</body>
</html>